def sum_list(nums):
    total = 0
    for num in nums:
        total += num
    return total

def avg_list(nums):
    total = 0
    for num in nums:
        total += num
    return total / len(nums)

def avg_list2(nums):
    total = 0
    for num in nums:
        total += num
    lowest = min(nums)
    return (total - lowest) / (len(nums) - 1)


def copy_list(orig_list):
    new_list = []
    for item in orig_list:
        new_list.append((item))
    return new_list

